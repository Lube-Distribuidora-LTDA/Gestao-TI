{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "crons": [
    {
      "path": "/api/cron/ler-emails",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/cobrar",
      "schedule": "0 12 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/robo/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/documentos/route.ts": {
      "maxDuration": 60
    }
  }
}
