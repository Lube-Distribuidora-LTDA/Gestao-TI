# =====================================================================
# GESTÃO DE TI — LUBE DISTRIBUIDORA
#
# Modelo de configuração. Copie para `.env.local` e preencha os valores.
# O arquivo .env.local NÃO vai para o Git — as mesmas chaves precisam ser
# cadastradas em Vercel > Settings > Environment Variables.
# =====================================================================

# ---------- Supabase (projeto "GESTAO TI") ----------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings > API Keys > service_role (secret)
# Ignora todas as regras de segurança do banco. Só existe no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Sessão do painel ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---------- Leitura do webmail (IMAP - Locaweb) ----------
# O certificado do servidor da Locaweb é *.email-ssl.com.br — usar
# imap.<seudominio> quebra a validação TLS.
IMAP_HOST=email-ssl.com.br
IMAP_PORT=993
IMAP_USER=cpd@lube.com.br
IMAP_PASS=
IMAP_PASTA=INBOX

# ---------- Envio de e-mail (SMTP - Locaweb) ----------
SMTP_HOST=email-ssl.com.br
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=cpd@lube.com.br
SMTP_PASS=
SMTP_FROM_NOME=TI - Lube Distribuidora

# ---------- Automação ----------
# Protege as rotas /api/cron/*. Use um valor aleatório e o mesmo na Vercel.
CRON_SECRET=

# Endereço público do sistema — usado nos links enviados por e-mail.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Quem recebe o aviso de chamado novo (vazio = não avisa).
TI_EMAIL_AVISOS=cpd@lube.com.br
