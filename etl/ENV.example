# Agente da Rotina 750 (GESTAO TI) - copie para um arquivo chamado ENV, sem extensao,
# na mesma pasta, e preencha. O ENV nunca vai para o git (este repositorio e publico).

# WinThor (so leitura) - copie as cinco linhas ORACLE_ do ENV de um dos BIs
ORACLE_HOST=...
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=...
ORACLE_USER=...
ORACLE_PASSWORD="..."

# Supabase do GESTAO TI (projeto gestao-ti, nao o DATA WAREHOUSE)
# Settings > API: Project URL e a chave service_role (secreta).
GESTAO_TI_SUPABASE_URL=https://....supabase.co
GESTAO_TI_SERVICE_ROLE_KEY="..."
